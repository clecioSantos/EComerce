# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
# O projeto usa SUPABASE apenas como PostgreSQL gerenciado, através do Prisma.
# Não é usada a Supabase Data API (supabase-js) nem RLS. O schema Prisma é a
# fonte da verdade da estrutura do banco.
#
# DATABASE_URL: conexão usada pela APLICAÇÃO em runtime (driver pg).
#   Desenvolvimento local (padrão abaixo) usa o PostgreSQL do docker-compose.
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"
#
# DIRECT_URL (opcional, recomendada no Supabase): usada SOMENTE pelo Prisma CLI
# (migrate / db push / studio). Se ausente, o CLI usa DATABASE_URL.
# SHADOW_DATABASE_URL (opcional): banco "shadow" para `prisma migrate dev`.
SHADOW_DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce_shadow?schema=public"
#
# --- Modelo para Supabase (substitua os placeholders; NUNCA comite valores) ---
# Hostinger (Node persistente): prefira o Session Pooler (porta 5432) ou a
# conexão direta. O Transaction Pooler (porta 6543) também funciona, mas exige
# pool baixo (DATABASE_POOL_MAX=1) e os parâmetros ?pgbouncer=true&connection_limit=1.
#
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require&schema=public"
# DIRECT_URL="postgresql://postgres:<SENHA>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require&schema=public"
#
# Pool do driver pg em runtime. Default: 10. Com Transaction Pooler, use 1.
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Autenticação (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Gere um segredo com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="E-commerce Core"

# ---------------------------------------------------------------------------
# Provedores plugáveis
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER: mock
# SHIPPING_PROVIDER: fixed | pickup | melhor-envio
PAYMENT_PROVIDER="mock"
SHIPPING_PROVIDER="fixed"

# ---------------------------------------------------------------------------
# Melhor Envio (cálculo de fretes)
# ---------------------------------------------------------------------------
# Token de acesso (server-side). NUNCA comite o valor real nem use NEXT_PUBLIC_*.
TOKEN_MELHOR_ENVIO=""
# Ambiente: sandbox (padrão) para testes; produção para valores reais.
#   sandbox:    https://sandbox.melhorenvio.com.br
#   produção:   https://melhorenvio.com.br
MELHOR_ENVIO_API_URL="https://sandbox.melhorenvio.com.br"
# User-Agent exigido pela API: nome da aplicação + e-mail de contato técnico.
MELHOR_ENVIO_USER_AGENT="E-commerce Core"
MELHOR_ENVIO_USER_AGENT_EMAIL=""

# ---------------------------------------------------------------------------
# Manutenção / cron
# ---------------------------------------------------------------------------
# Segredo exigido pelo endpoint interno de expiração de reservas.
# Gere com: openssl rand -hex 32
CRON_SECRET="troque-por-um-segredo-do-cron"

# Provedores reais (futuro)
# MERCADOPAGO_ACCESS_TOKEN=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# MELHORENVIO_TOKEN=""
