# Agent runtime - use a dedicated PostgreSQL database
PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom_agent
# generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=
# Strong admin dashboard password, served only over HTTPS
ADMIN_PASSWORD=
# Meta app settings (not the store's phone or access token)
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Gemini API for sales chat, tools and audio transcription
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Public server URL for webhook configuration / dashboard orientation
PUBLIC_BASE_URL=https://agent.example.com

# comma-separated trusted API domains, mandatory for external stores
ALLOWED_COMMERCE_HOSTS=loja.exemplo.com.br
