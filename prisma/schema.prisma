// E-commerce Core — schema genérico, desacoplado de qualquer segmento.
// Nenhum campo específico de "roupas" vive aqui: atributos e variantes são genéricos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidade e clientes
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model Store {
  conditionalSettings ConditionalSettings?
  conditionalProfiles ConditionalCustomerProfile[]
  conditionalCases ConditionalCase[]
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  tagline String?
  logoUrl String?
  primaryColor String @default("#202b35")
  accentColor String @default("#d7a66a")
  agentServiceId String? @unique // Binding to the independent WhatsApp agent service
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  carts    Cart[]
  orders   Order[]
  agents   AgentApiCredential[]
  checkoutLinks AgentCheckoutSession[]

  @@map("stores")
}

// Keys are stored as one-way SHA-256 hashes; raw keys are never persisted.
model AgentApiCredential {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  keyHash   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  revokedAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId])
  @@map("agent_api_credentials")
}

model AgentCheckoutSession {
  id         String   @id @default(cuid())
  storeId    String
  cartId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  @@index([storeId, expiresAt])
  @@map("agent_checkout_sessions")
}

model User {
  legacyConditionalCustomer ConditionalCustomer?
  legacyConditionalAcceptances ConditionalTermAcceptance[]
  conditionalProfiles ConditionalCustomerProfile[]
  conditionalCases ConditionalCase[]
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  carts        Cart[]
  couponUsages CouponUsage[]
  accounts     Account[]
  sessions     Session[]
  savedCards   SavedCard[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  recipient  String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("BR")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catálogo genérico
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Tipos de atributo. Os primeiros são implementados; os demais ficam
// preparados para evolução sem mudar o restante do domínio.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  COLOR
  RANGE
  DIMENSION
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryTree")
  products   Product[]
  promotions Promotion[]

  @@index([parentId])
  @@map("categories")
}

model ProductType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attributes ProductAttribute[]
  products   Product[]

  @@map("product_types")
}

model ProductAttribute {
  id               String        @id @default(cuid())
  productTypeId    String
  name             String
  slug             String
  type             AttributeType @default(TEXT)
  description      String?
  unit             String?
  isRequired       Boolean       @default(false)
  allowMultiple    Boolean       @default(false)
  isFilterable     Boolean       @default(false)
  isVariantDefining Boolean      @default(false)
  position         Int           @default(0)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  productType        ProductType               @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  values             ProductAttributeValue[]
  assignments        ProductAttributeAssignment[]
  variantAttributes  ProductVariantAttribute[]

  @@unique([productTypeId, slug])
  @@index([productTypeId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String   @id @default(cuid())
  attributeId String
  value       String
  slug        String
  position    Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  attribute        ProductAttribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  assignments      ProductAttributeAssignment[]
  variantAttributes ProductVariantAttribute[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@map("product_attribute_values")
}

// Atributo descritivo (não variante) aplicado ao produto.
// Para SELECT/MULTI_SELECT usa attributeValueId; para TEXT/NUMBER/BOOLEAN usa value (JSON).
model ProductAttributeAssignment {
  id               String  @id @default(cuid())
  productId        String
  attributeId      String
  attributeValueId String?
  value            Json?

  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      ProductAttribute       @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue ProductAttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@unique([productId, attributeId, attributeValueId])
  @@index([productId])
  @@index([attributeId])
  @@map("product_attribute_assignments")
}

model Product {
  conditionalEligible Boolean @default(true)
  storeId          String        @default("legacy-store")
  store            Store         @relation(fields: [storeId], references: [id])
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  status           ProductStatus @default(DRAFT)
  productTypeId    String
  categoryId       String?
  brandId          String?
  basePrice        Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("BRL")
  isFeatured       Boolean       @default(false)
  metadata         Json?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  productType  ProductType            @relation(fields: [productTypeId], references: [id])
  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  assignments  ProductAttributeAssignment[]
  reviews      Review[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productTypeId])
  @@index([categoryId])
  @@index([status])
  @@index([status, categoryId])
  @@index([status, productTypeId])
  @@index([status, createdAt])
  @@map("products")
  @@index([storeId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model ProductVariant {
  conditionalItems ConditionalItem[]
  legacyConditionalStockHolds ConditionalStockHold[]
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  signature      String
  name           String?
  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  // Dados logísticos genéricos (necessários para cotação de frete). Peso em kg,
  // dimensões em cm. Ficam na variante porque variantes do mesmo produto podem
  // ter pesos/dimensões diferentes.
  weight         Decimal? @db.Decimal(10, 3)
  width          Decimal? @db.Decimal(10, 2)
  height         Decimal? @db.Decimal(10, 2)
  length         Decimal? @db.Decimal(10, 2)
  barcode        String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes ProductVariantAttribute[]
  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  stockReservations StockReservation[]

  @@unique([productId, signature])
  @@index([productId])
  @@map("product_variants")
}

model ProductVariantAttribute {
  id               String @id @default(cuid())
  variantId        String
  attributeId      String
  attributeValueId String

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      ProductAttribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([attributeId, attributeValueId])
  @@map("product_variant_attributes")
}

// ---------------------------------------------------------------------------
// Estoque (sempre na variante)
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  CONDITIONAL
  IN
  OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUME
  RESTOCK
}

model Inventory {
  quantityOnConditional Int @default(0)
  quantityQuarantined Int @default(0)
  id               String   @id @default(cuid())
  variantId        String   @unique
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(0)
  allowBackorder   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant   ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  variantId   String
  type        InventoryMovementType
  quantity    Int
  reason      String?
  referenceId String?
  userId      String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([inventoryId])
  @@index([variantId])
  @@map("inventory_movements")
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model StockReservation {
  id        String                 @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  status    StockReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime               @default(now())
  releasedAt DateTime?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([variantId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Carrinho
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  storeId      String     @default("legacy-store")
  store        Store      @relation(fields: [storeId], references: [id])
  id           String     @id @default(cuid())
  userId       String?
  sessionToken String?    @unique
  status       CartStatus @default(ACTIVE)
  currency     String     @default("BRL")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]
  checkoutLinks AgentCheckoutSession[]

  @@index([userId])
  @@map("carts")
  @@index([storeId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  WALLET
  OTHER
}

model Order {
  type OrderType @default(NORMAL)
  legacyConditionalPurchase ConditionalPurchase?
  conditionalCaseId String? @unique
  conditionalCase ConditionalCase? @relation(fields: [conditionalCaseId], references: [id], onDelete: Restrict)
  @@index([type])
  storeId           String        @default("legacy-store")
  store             Store         @relation(fields: [storeId], references: [id])
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  customerName      String
  customerEmail     String
  customerPhone     String?
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal       @db.Decimal(12, 2)
  currency          String        @default("BRL")
  couponId          String?
  couponCode        String?
  idempotencyKey    String?       @unique
  requestHash       String?
  // Carrinho de origem: só é esvaziado quando o pagamento é confirmado (PAID).
  cartId            String?
  shippingAddress   Json
  billingAddress    Json?
  shippingProvider  String?
  shippingMethod    String?
  shippingServiceId String?
  shippingCompany   String?
  shippingEstimatedDaysMin Int?
  shippingEstimatedDaysMax Int?
  shippingSnapshot  Json?
  trackingCode      String?
  notes             String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon       Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  couponUsage  CouponUsage?
  stockReservations StockReservation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([cartId])
  @@map("orders")
  @@index([storeId])
}

model OrderItem {
  legacyConditionalItem ConditionalPurchaseItem?
  id                 String   @id @default(cuid())
  orderId            String
  productId          String?
  variantId          String?
  productName        String
  variantName        String?
  sku                String
  unitPrice          Decimal  @db.Decimal(12, 2)
  quantity           Int
  total              Decimal  @db.Decimal(12, 2)
  discountTotal      Decimal  @default(0) @db.Decimal(12, 2)
  attributesSnapshot Json?
  imageUrl           String?
  metadata           Json?
  createdAt          DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Pagamentos
// ---------------------------------------------------------------------------

enum PaymentTransactionType {
  CHARGE
  REFUND
  CANCEL
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?
  idempotencyKey    String?
  method            PaymentMethod @default(OTHER)
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("BRL")
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([orderId, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                 @id @default(cuid())
  paymentId             String
  type                  PaymentTransactionType
  status                PaymentStatus          @default(PENDING)
  amount                Decimal                @db.Decimal(12, 2)
  providerTransactionId String?
  metadata              Json?
  createdAt             DateTime               @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

enum PaymentEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model PaymentEvent {
  id              String             @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json?
  status          PaymentEventStatus @default(PROCESSING)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([status])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Contas de provedores de pagamento (OAuth) e states de autorização
// ---------------------------------------------------------------------------

// Credenciais da conta do provedor conectada à loja (ex.: Mercado Pago OAuth).
// Tokens são persistidos CIFRADOS (AES-256-GCM) pela camada de aplicação e
// nunca devem ser retornados para o cliente nem logados.
model PaymentProviderAccount {
  id                 String    @id @default(cuid())
  provider           String    @unique
  providerUserId     String?
  accessToken        String
  refreshToken       String?
  publicKey          String?
  tokenType          String?
  scope              String?
  expiresAt          DateTime?
  // Lease para serializar renovações concorrentes do refresh token.
  refreshLockedUntil DateTime?
  liveMode           Boolean   @default(false)
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("payment_provider_accounts")
}

// Estado OAuth de uso único (anti-CSRF/replay). Consumido no callback.
model PaymentOAuthState {
  id           String    @id @default(cuid())
  state        String    @unique
  provider     String
  userId       String
  codeVerifier String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([provider, state])
  @@index([expiresAt])
  @@map("payment_oauth_states")
}

// Cartão salvo do cliente. O PAN NUNCA é armazenado aqui: o Mercado Pago
// guarda o cartão (Customers & Cards API) e nós referenciamos o `card_id`.
// O código de segurança (CVV) nunca é persistido.
model SavedCard {
  id                 String   @id @default(cuid())
  userId             String
  provider           String   @default("mercadopago")
  providerCustomerId String
  providerCardId     String
  brand              String?
  lastFourDigits     String
  firstSixDigits     String?
  expirationMonth    Int?
  expirationYear     Int?
  cardholderName     String?
  paymentMethodId    String?
  issuerId           String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCardId])
  @@index([userId])
  @@map("saved_cards")
}

// ---------------------------------------------------------------------------
// Promoções e cupons
// ---------------------------------------------------------------------------
enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionScope {
  CART
  CATEGORY
  PRODUCT
}

model Promotion {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  value       Decimal        @default(0) @db.Decimal(12, 2)
  scope       PromotionScope @default(CART)
  categoryId  String?
  productId   String?
  minSubtotal Decimal?       @db.Decimal(12, 2)
  minQuantity Int?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean        @default(true)
  stackable   Boolean        @default(true)
  priority    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([categoryId])
  @@map("promotions")
}

model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  description    String?
  type           PromotionType
  value          Decimal       @default(0) @db.Decimal(12, 2)
  minSubtotal    Decimal?      @db.Decimal(12, 2)
  maxUses        Int?
  maxUsesPerUser Int?
  usedCount      Int           @default(0)
  isActive       Boolean       @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  usages CouponUsage[]
  orders Order[]

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String?
  orderId  String   @unique
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ---------------------------------------------------------------------------
// Avaliações
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Configurações da loja (singleton)
// ---------------------------------------------------------------------------

// Endereço de origem dos envios + serviços de frete habilitados. O CEP de
// origem é o dado essencial para a cotação; o restante fica para emissão de
// etiquetas/documentos em etapas futuras.
model StoreSettings {
  id                 String   @id @default("default")
  postalCode         String
  street             String
  number             String
  complement         String?
  district           String
  city               String
  state              String
  // IDs dos serviços do Melhor Envio habilitados (ex.: ["1", "2"]).
  shippingServiceIds String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("store_settings")
}

// Condicional: independent custody lifecycle; regular order reservations stay unchanged.
model ConditionalSettings {
  storeId              String   @id
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  enabled              Boolean  @default(false)
  maxOpenAmount        Decimal  @default(0) @db.Decimal(12, 2)
  maxOpenUnits         Int      @default(0)
  maxCaseAmount        Decimal  @default(0) @db.Decimal(12, 2)
  maxCaseUnits         Int      @default(0)
  maxOpenCases         Int      @default(0)
  trialDays            Int      @default(3)
  returnDays           Int      @default(5)
  paymentDays          Int      @default(3)
  reserveHours         Int      @default(24)
  requestHours         Int      @default(48)
  terms                String   @default("")
  termsVersion         Int      @default(1)
  customerPaysShipping Boolean  @default(false)
  returnFee            Decimal  @default(0) @db.Decimal(12, 2)
  freightPolicy        String   @default("")
  updatedAt            DateTime @updatedAt

  @@map("conditional_settings")
}

model ConditionalCustomerProfile {
  id            String    @id @default(cuid())
  storeId       String
  userId        String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  eligibility   String    @default("NOT_REVIEWED")
  useStoreLimits Boolean  @default(true)
  maxOpenAmount Decimal   @default(0) @db.Decimal(12, 2)
  maxOpenUnits  Int       @default(0)
  maxCaseAmount Decimal   @default(0) @db.Decimal(12, 2)
  maxCaseUnits  Int       @default(0)
  maxOpenCases  Int       @default(0)
  currency      String    @default("BRL")
  eligibleUntil DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String    @default("")
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, userId])
  @@index([storeId, eligibility])
  @@map("conditional_customer_profiles")
}

model ConditionalCase {
  id               String                @id @default(cuid())
  number           String                @unique
  storeId          String
  userId           String
  store            Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           String                @default("REQUESTED")
  requestKey       String                @unique
  requestHash      String
  currency         String                @default("BRL")
  address          Json
  terms            String
  termsVersion     Int
  freightPolicy    String
  policy           Json
  acceptedAt       DateTime
  approvedAt       DateTime?
  dispatchedAt     DateTime?
  receivedAt       DateTime?
  decidedAt        DateTime?
  closedAt         DateTime?
  requestDueAt     DateTime
  reserveDueAt     DateTime?
  choiceDueAt      DateTime?
  returnDueAt      DateTime?
  paymentDueAt     DateTime?
  shippingFee      Decimal               @db.Decimal(12, 2)
  returnFee        Decimal               @db.Decimal(12, 2)
  shippingSnapshot Json
  issue            String?
  items            ConditionalItem[]
  events           ConditionalEvent[]
  returns          ConditionalReturn[]
  shipments        ConditionalShipment[]
  order            Order?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([storeId, userId, status])
  @@index([storeId, status, choiceDueAt])
  @@map("conditional_cases")
}

model ConditionalItem {
  purchasedReceivedQuantity Int                 @default(0)
  purchasedApprovedQuantity Int                 @default(0)
  id                        String              @id @default(cuid())
  caseId                    String
  case                      ConditionalCase     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  variantId                 String
  variant                   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productId                 String
  productName               String
  variantName               String
  sku                       String
  imageUrl                  String?
  unitPrice                 Decimal             @db.Decimal(12, 2)
  quantity                  Int
  keepQuantity              Int?
  soldQuantity              Int                 @default(0)
  receivedQuantity          Int                 @default(0)
  approvedReturnQuantity    Int                 @default(0)
  writtenOffQuantity        Int                 @default(0)
  returns                   ConditionalReturn[]

  @@unique([caseId, variantId])
  @@index([variantId])
  @@map("conditional_items")
}

model ConditionalEvent {
  id        String          @id @default(cuid())
  caseId    String
  case      ConditionalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  key       String          @unique
  type      String
  actorId   String?
  message   String
  data      Json?
  createdAt DateTime        @default(now())

  @@index([caseId, createdAt])
  @@map("conditional_events")
}

model ConditionalProfileEvent {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  actorId   String
  reason    String
  before    Json?
  after     Json
  createdAt DateTime @default(now())

  @@index([storeId, userId, createdAt])
  @@map("conditional_profile_events")
}

model ConditionalShipment {
  id        String          @id @default(cuid())
  caseId    String
  case      ConditionalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  direction String
  tracking  String
  evidence  String
  createdAt DateTime        @default(now())

  @@index([caseId, direction])
  @@map("conditional_shipments")
}

model ConditionalReturn {
  purchased   Boolean         @default(false)
  id          String          @id @default(cuid())
  caseId      String
  case        ConditionalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  itemId      String
  item        ConditionalItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Int
  outcome     String          @default("PENDING")
  evidence    String
  inspectedBy String?
  inspectedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([caseId, outcome])
  @@index([itemId])
  @@map("conditional_returns")
}

// Preserved legacy conditional schema recovered from pendents (migration 14).
enum OrderType {
  NORMAL
  CONDITIONAL
}

enum ReturnShippingPolicy {
  FREE
  MIN_PURCHASE
  PAID
}

model ConditionalPurchasePolicy {
  id                        String               @id @default("default")
  enabled                   Boolean              @default(false)
  maxItemsPerOrder          Int                  @default(5)
  maxOrderAmount            Decimal              @default(1500) @db.Decimal(12, 2)
  maxOpenConditionalOrders  Int                  @default(1)
  maxCustomerExposure       Decimal              @default(1500) @db.Decimal(12, 2)
  decisionDeadlineDays      Int                  @default(7)
  // Frete de devolução: grátis, grátis acima de X, ou sempre cobrado.
  returnShippingPolicy      ReturnShippingPolicy @default(FREE)
  returnShippingMinPurchase Decimal?             @db.Decimal(12, 2)
  returnShippingAmount      Decimal?             @db.Decimal(12, 2)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@map("conditional_purchase_policies")
}

enum ConditionalCustomerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model ConditionalCustomer {
  id          String                    @id @default(cuid())
  userId      String                    @unique
  status      ConditionalCustomerStatus @default(PENDING)
  approvedAt  DateTime?
  approvedBy  String?
  rejectedAt  DateTime?
  rejectedBy  String?
  suspendedAt DateTime?
  suspendedBy String?
  reason      String?

  overrideEnabled        Boolean?
  overrideMaxItems       Int?
  overrideMaxOrderAmount Decimal? @db.Decimal(12, 2)
  overrideMaxOpenOrders  Int?
  overrideMaxExposure    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("conditional_customers")
}

model ConditionalTerm {
  id        String   @id @default(cuid())
  version   Int      @unique
  title     String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances ConditionalTermAcceptance[]
  purchases   ConditionalPurchase[]

  @@map("conditional_terms")
}

model ConditionalTermAcceptance {
  id         String   @id @default(cuid())
  termId     String
  userId     String
  acceptedAt DateTime @default(now())

  term ConditionalTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([termId, userId])
  @@index([userId])
  @@map("conditional_term_acceptances")
}

enum ConditionalPurchaseStatus {
  PENDING_APPROVAL
  APPROVED
  PREPARING
  SHIPPED
  DELIVERED
  DECISION_PENDING
  PROCESSING_DECISION
  COMPLETED
  RETURNING
  INSPECTING
  ISSUE_FOUND
  CANCELLED
  EXPIRED
}

model ConditionalPurchase {
  id                  String                    @id @default(cuid())
  orderId             String                    @unique
  status              ConditionalPurchaseStatus @default(PENDING_APPROVAL)
  termId              String?
  termVersion         Int?
  termAcceptedAt      DateTime?
  // Snapshot da política efetiva aplicada na criação do pedido.
  policySnapshot      Json?
  // Valor das mercadorias sob responsabilidade do cliente (entra na exposição).
  exposureAmount      Decimal                   @db.Decimal(12, 2)
  deliveredAt         DateTime?
  decisionDeadline    DateTime?
  decisionFinalizedAt DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  order      Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  term       ConditionalTerm?          @relation(fields: [termId], references: [id], onDelete: SetNull)
  items      ConditionalPurchaseItem[]
  stockHolds ConditionalStockHold[]
  returns    Return[]

  @@index([status])
  @@index([decisionDeadline])
  @@map("conditional_purchases")
}

enum ConditionalItemDecision {
  KEEP
  RETURN
}

enum ConditionalItemStatus {
  PENDING_DECISION
  KEEP
  RETURN
  RETURNING
  RETURNED
  INSPECTED
}

enum ConditionalInspectionStatus {
  PENDING
  ACCEPTED
  DAMAGED
  MISSING
  INCOMPLETE
}

model ConditionalPurchaseItem {
  id                    String                       @id @default(cuid())
  conditionalPurchaseId String
  orderItemId           String                       @unique
  status                ConditionalItemStatus        @default(PENDING_DECISION)
  customerDecision      ConditionalItemDecision?
  decidedAt             DateTime?
  returnedAt            DateTime?
  receivedAt            DateTime?
  inspectionStatus      ConditionalInspectionStatus? @default(PENDING)
  inspectedAt           DateTime?
  inspectedBy           String?
  inspectionNote        String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  conditionalPurchase ConditionalPurchase   @relation(fields: [conditionalPurchaseId], references: [id], onDelete: Cascade)
  orderItem           OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stockHold           ConditionalStockHold?
  returnItems         ReturnItem[]

  @@index([conditionalPurchaseId])
  @@index([status])
  @@map("conditional_purchase_items")
}

enum ConditionalStockHoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model ConditionalStockHold {
  id                    String                     @id @default(cuid())
  conditionalPurchaseId String
  conditionalItemId     String?                    @unique
  variantId             String
  quantity              Int
  status                ConditionalStockHoldStatus @default(ACTIVE)
  createdAt             DateTime                   @default(now())
  releasedAt            DateTime?

  conditionalPurchase ConditionalPurchase      @relation(fields: [conditionalPurchaseId], references: [id], onDelete: Cascade)
  item                ConditionalPurchaseItem? @relation(fields: [conditionalItemId], references: [id], onDelete: Cascade)
  variant             ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([conditionalPurchaseId])
  @@index([variantId])
  @@index([status])
  @@map("conditional_stock_holds")
}

enum ReturnStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  INSPECTING
  COMPLETED
  ISSUE
}

model Return {
  id                    String       @id @default(cuid())
  conditionalPurchaseId String
  status                ReturnStatus @default(REQUESTED)
  receivedAt            DateTime?
  inspectedAt           DateTime?
  inspectedBy           String?
  note                  String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  conditionalPurchase ConditionalPurchase @relation(fields: [conditionalPurchaseId], references: [id], onDelete: Cascade)
  items               ReturnItem[]

  @@index([conditionalPurchaseId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id                String                      @id @default(cuid())
  returnId          String
  conditionalItemId String
  inspectionStatus  ConditionalInspectionStatus @default(PENDING)
  note              String?
  createdAt         DateTime                    @default(now())

  return          Return                  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  conditionalItem ConditionalPurchaseItem @relation(fields: [conditionalItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, conditionalItemId])
  @@map("return_items")
}

model AuditEvent {
  id          String   @id @default(cuid())
  event       String
  entity      String
  entityId    String?
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_events")
}
